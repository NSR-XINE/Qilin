<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 17 Dialog Enter Animation -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:fromXScale="0.88"
        android:toXScale="1.0"
        android:fromYScale="0.88"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:interpolator="@interpolator/coloros_emphasized_decelerate"
        android:duration="@integer/oplus_animation_time_move" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:interpolator="@interpolator/coloros_fast_out_slow_in"
        android:duration="@integer/oplus_animation_time_move_fast" />
</set>
