<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 17 Bottom Sheet Enter Animation -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromYDelta="100%"
        android:toYDelta="0%"
        android:interpolator="@interpolator/coloros_emphasized_decelerate"
        android:duration="360" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:interpolator="@interpolator/coloros_fast_out_slow_in"
        android:duration="@integer/oplus_animation_time_move_fast" />
</set>
