<?xml version="1.0" encoding="utf-8"?>
<!-- ColorOS 17 Task Close Slide Enter Animation -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="-25%"
        android:toXDelta="0%"
        android:interpolator="@interpolator/coloros_emphasized_decelerate"
        android:duration="@integer/oplus_animation_time_move" />
    <alpha
        android:fromAlpha="0.7"
        android:toAlpha="1.0"
        android:interpolator="@interpolator/coloros_fast_out_slow_in"
        android:duration="@integer/oplus_animation_time_move" />
</set>
